DJANGO_SECRET_KEY=replace-this-with-a-long-random-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DATABASE_URL=postgres://simmer:simmer_local_only@db:5432/simmer
THEMEALDB_API_KEY=1
MEDIA_ROOT=/app/media
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Simmer <replace-with-verified-sender@example.com>
SIMMER_PUBLIC_URL=https://simmer-api.duckdns.org
SIMMER_CONTACT_EMAIL=replace-with-support-email@example.com
GOOGLE_OAUTH_CLIENT_IDS=replace-with-google-web-client-id.apps.googleusercontent.com
SIMMER_ADS_ENABLED=False
SIMMER_AD_INTERVAL=5
AI_PROVIDER=openai
AI_API_KEY=replace-with-server-side-ai-provider-key
AI_MODEL=replace-with-a-supported-api-model
AI_API_BASE_URL=https://api.openai.com/v1
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_DAILY_MESSAGES=50
AI_MONTHLY_BUDGET_USD=0
AI_INPUT_PRICE_PER_MILLION_USD=0
AI_OUTPUT_PRICE_PER_MILLION_USD=0
GOOGLE_PLAY_PACKAGE_NAME=com.simmer.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PRODUCTS_ENABLED=False
SIMMER_REWARD_TIME_ZONE=America/Sao_Paulo
