# Copy to /opt/simmer/shared/.env on the VPS and replace the placeholders.
POSTGRES_DB=simmer
POSTGRES_USER=simmer
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY
SIMMER_DOMAIN=REPLACE_WITH_REGISTERED_DUCKDNS_SUBDOMAIN
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_REGISTERED_DUCKDNS_SUBDOMAIN,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://REPLACE_WITH_REGISTERED_DUCKDNS_SUBDOMAIN
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=0
