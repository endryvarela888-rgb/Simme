# Copy to /opt/simmer/shared/.env on the VPS and replace the placeholders.
POSTGRES_DB=simmer
POSTGRES_USER=simmer
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY
SIMMER_DOMAIN=REPLACE_WITH_REGISTERED_DUCKDNS_SUBDOMAIN
DJANGO_ALLOWED_HOSTS=REPLACE_WITH_REGISTERED_DUCKDNS_SUBDOMAIN,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://REPLACE_WITH_REGISTERED_DUCKDNS_SUBDOMAIN
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=0
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=replace-with-your-provider-smtp-host
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-your-provider-smtp-username
EMAIL_HOST_PASSWORD=replace-with-your-provider-smtp-password
DEFAULT_FROM_EMAIL=Simmer <replace-with-verified-sender@example.com>
SIMMER_PUBLIC_URL=https://simmer-api.duckdns.org
SIMMER_CONTACT_EMAIL=replace-with-support-email@example.com
GOOGLE_OAUTH_CLIENT_IDS=replace-with-google-web-client-id.apps.googleusercontent.com
SIMMER_ADS_ENABLED=False
SIMMER_AD_INTERVAL=5
